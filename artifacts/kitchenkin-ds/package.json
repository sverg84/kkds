{
  "name": "@sverg84/kkds-react",
  "version": "0.2.0",
  "type": "module",
  "description": "KitchenKin Design System — components, tokens, and styles for the web",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./tokens.json": "./tokens.json",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens.json",
    "README.md"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "theme": "node scripts/build-theme.mjs",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build:css": "node scripts/build-css.mjs",
    "build:lib": "rm -rf dist && pnpm theme && tsup && pnpm build:css",
    "build:preview": "vite build --config vite.config.ts",
    "build": "pnpm run build:lib",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "pretypecheck": "pnpm theme",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sverg84/kkds-common": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "^0.5.1",
    "@replit/vite-plugin-dev-banner": "^0.1.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
