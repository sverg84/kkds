{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "KitchenKin Design System — DTCG token source. Edit values here only; run `pnpm tokens` to regenerate src/index.css and src/generated/tokens.tsx. Colors are hex; the generator converts them to HSL channels for the shadcn theme and keeps hex for mobile consumers. Every color role appears in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f4f5e4", "$description": "Warm cream page background." },
      "foreground": { "$value": "#6b4226", "$description": "Warm brown default text." },
      "border": { "$value": "#e5e5e5" },
      "card": { "$value": "#f4f5e4" },
      "cardForeground": { "$value": "#6b4226" },
      "popover": { "$value": "#f4f5e4" },
      "popoverForeground": { "$value": "#6b4226" },
      "primary": {
        "$value": "#ff7b54",
        "$description": "KitchenKin coral-orange. Used for primary buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#6b4226" },
      "secondary": {
        "$value": "#f4a261",
        "$description": "Warm amber-orange. Supporting actions and secondary emphasis."
      },
      "secondaryForeground": { "$value": "#6b4226" },
      "muted": { "$value": "#e8e9d6", "$description": "Light warm muted surface." },
      "mutedForeground": { "$value": "#957661" },
      "accent": {
        "$value": "#e76f51",
        "$description": "Deeper orange accent. Hover states and tonal highlights."
      },
      "accentForeground": { "$value": "#6b4226" },
      "destructive": { "$value": "#e7000b" },
      "destructiveForeground": { "$value": "#fff5f0" },
      "input": { "$value": "#e5e5e5" },
      "ring": { "$value": "#a1a1a1" },
      "chart1": { "$value": "#f54900" },
      "chart2": { "$value": "#009689" },
      "chart3": { "$value": "#104e64" },
      "chart4": { "$value": "#ffb900" },
      "chart5": { "$value": "#fe9a00" },
      "sidebar": { "$value": "#fafafa" },
      "sidebarForeground": { "$value": "#252525" },
      "sidebarBorder": { "$value": "#e5e5e5" },
      "sidebarPrimary": { "$value": "#353535" },
      "sidebarPrimaryForeground": { "$value": "#fafafa" },
      "sidebarAccent": { "$value": "#f5f5f5" },
      "sidebarAccentForeground": { "$value": "#353535" },
      "sidebarRing": { "$value": "#a1a1a1" }
    },
    "dark": {
      "background": { "$value": "#1c1208", "$description": "Very dark warm brown surface — warm-toned, not cold gray." },
      "foreground": { "$value": "#f5eee6", "$description": "Warm off-white text." },
      "border": { "$value": "#3a2614" },
      "card": { "$value": "#241a0d" },
      "cardForeground": { "$value": "#f5eee6" },
      "popover": { "$value": "#241a0d" },
      "popoverForeground": { "$value": "#f5eee6" },
      "primary": {
        "$value": "#ff8b66",
        "$description": "Coral-orange, slightly brightened for dark backgrounds."
      },
      "primaryForeground": { "$value": "#1c1208" },
      "secondary": { "$value": "#3a2614" },
      "secondaryForeground": { "$value": "#f5eee6" },
      "muted": { "$value": "#2d1e0f" },
      "mutedForeground": { "$value": "#a8886b" },
      "accent": { "$value": "#cc5a36" },
      "accentForeground": { "$value": "#f5eee6" },
      "destructive": { "$value": "#b83028" },
      "destructiveForeground": { "$value": "#f5eee6" },
      "input": { "$value": "#3a2614" },
      "ring": { "$value": "#ff8b66" },
      "chart1": { "$value": "#ff7b54" },
      "chart2": { "$value": "#3dbcab" },
      "chart3": { "$value": "#5b8fbf" },
      "chart4": { "$value": "#f4c842" },
      "chart5": { "$value": "#f4a83c" },
      "sidebar": { "$value": "#1c1208" },
      "sidebarForeground": { "$value": "#f5eee6" },
      "sidebarBorder": { "$value": "#3a2614" },
      "sidebarPrimary": { "$value": "#ff8b66" },
      "sidebarPrimaryForeground": { "$value": "#1c1208" },
      "sidebarAccent": { "$value": "#2d1e0f" },
      "sidebarAccentForeground": { "$value": "#f5eee6" },
      "sidebarRing": { "$value": "#ff8b66" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Quicksand", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "KitchenKin primary display and UI sans-serif (Quicksand via Google Fonts)."
      },
      "serif": {
        "$value": ["Georgia", "Times New Roman", "serif"],
        "$description": "Serif for editorial and recipe contexts."
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"],
        "$description": "Monospace stack for code and measurement labels."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.625rem",
      "$description": "Base corner radius (10px). Matches the web app's --radius: 0.625rem. sm/md/lg/xl derive from this."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step the shadcn components multiply."
    }
  }
}
